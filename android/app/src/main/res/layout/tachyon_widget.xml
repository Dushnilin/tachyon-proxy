<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="⚡ TACHYON · ОТКЛЮЧЕНО"
            android:textColor="#B9A8FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_server"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Нажмите для запуска"
            android:textColor="#F2F2F3"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_traffic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="↑ 0 Б/с · ↓ 0 Б/с"
            android:textColor="#A8A8AD"
            android:textSize="11sp" />
    </LinearLayout>

    <Button
        android:id="@+id/widget_toggle_btn"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:backgroundTint="#2A2440"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:text="ВКЛ"
        android:textColor="#B9A8FF"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
