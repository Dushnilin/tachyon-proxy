<?xml version="1.0" encoding="utf-8"?>
<!--
    Списки правил и подписки качаются с GitHub, поэтому для них нужен
    HTTPS. Остальной трафик идёт через туннель и его настройки не касаются.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
